# MediSync AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=medisync_ai

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Simulation Settings
SIMULATION_TICK_SECONDS=3
SIMULATION_MINUTES_PER_REAL_SECOND=1

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Demo Operator Token (simple auth for hackathon)
DEMO_OPERATOR_TOKEN=medisync-demo-2024
